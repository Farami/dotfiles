#!/bin/bash

set -e

echo "🍺 Starting Homebrew and package installation..."

# Install Homebrew if not already installed
if ! command -v brew &> /dev/null; then
    echo "📦 Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    
    # Add Homebrew to PATH for Apple Silicon Macs
    if [[ $(uname -m) == "arm64" ]]; then
        echo "🔧 Adding Homebrew to PATH for Apple Silicon..."
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
else
    echo "✅ Homebrew is already installed"
fi

# Update Homebrew
echo "🔄 Updating Homebrew..."
brew update

# Core tools
echo "📦 Installing core command-line tools..."
brew install fish              # Shell
brew install chezmoi          # Dotfile manager
brew install mise             # Version manager (replaces asdf)
brew install starship         # Shell prompt
brew install atuin            # Shell history

# Terminal multiplexers and utilities
echo "📦 Installing terminal tools..."
brew install zellij           # Terminal multiplexer

# Text editors and development
echo "📦 Installing editors and dev tools..."
brew install neovim           # Text editor
brew install lazygit          # Git TUI

# Modern CLI replacements
echo "📦 Installing modern CLI tools..."
brew install eza              # Modern ls replacement
brew install zoxide           # Smart cd
brew install bat              # Better cat
brew install ripgrep          # Better grep
brew install fd               # Better find
brew install fzf              # Fuzzy finder

# System monitoring and utilities
echo "📦 Installing system utilities..."
brew install btop             # System monitor
brew install fastfetch        # System info
brew install yazi             # Terminal file manager
brew install peco             # Interactive filter

# Task management
echo "📦 Installing task management tools..."
brew install task      # Task management
brew install taskwarrior-tui  # Task TUI
brew install timewarrior      # Time tracking

# Completions
echo "📦 Installing completion tools..."
brew install carapace         # Multi-shell completion generator

# macOS-specific tools (only install on macOS)
{{ if eq .chezmoi.os "darwin" -}}
echo "📦 Installing macOS-specific tools..."
brew install --cask ghostty    # Terminal emulator
brew tap FelixKratz/formulae
brew install sketchybar        # Status bar
brew install skhd              # Hotkey daemon
brew install yabai             # Window manager

# Fonts
echo "📦 Installing fonts..."
brew install --cask font-monaspace  # Monaspace font family (includes Monaspace Neon)

# Optional: macOS applications
echo "📦 Installing optional macOS applications..."
# Uncomment if you want these installed automatically:
# brew install --cask raycast        # Launcher/productivity
# brew install --cask spotify        # Music (for spotify-player)
{{ end -}}

# Development tools (managed separately but nice to have)
echo "📦 Installing additional development tools..."
brew install git              # Version control
brew install gh               # GitHub CLI
brew install jq               # JSON processor
brew install curl             # HTTP client
brew install wget             # File downloader

# Rust (cargo) - often better installed via rustup, but available in brew
echo "📦 Checking for Rust installation..."
if ! command -v cargo &> /dev/null; then
    echo "🦀 Installing Rust via rustup..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
else
    echo "✅ Rust is already installed"
fi

# Docker completions and tools
echo "📦 Installing container tools..."
brew install docker           # Docker CLI
brew install docker-compose   # Docker Compose

# Cleanup
echo "🧹 Cleaning up..."
brew cleanup

# Verify mise is installed and set up
echo "🔧 Setting up mise for version management..."
if command -v mise &> /dev/null; then
    echo "✅ Mise is installed"
    echo "📝 Note: Mise will manage the following tools (configured in ~/.config/mise/config.toml):"
    echo "   - bun"
    echo "   - java (openjdk-21)"
    echo "   - node"
    echo "   - python"
    echo "   - yarn"
    echo ""
    echo "   Run 'mise install' to install these tools"
fi

# Set fish as default shell (if not already)
{{ if eq .chezmoi.os "darwin" -}}
if [[ "$SHELL" != "$(which fish)" ]]; then
    echo "🐚 Setting fish as default shell..."
    FISH_PATH=$(which fish)
    if ! grep -q "$FISH_PATH" /etc/shells; then
        echo "$FISH_PATH" | sudo tee -a /etc/shells
    fi
    chsh -s "$FISH_PATH"
    echo "✅ Fish shell set as default. Please restart your terminal."
else
    echo "✅ Fish is already the default shell"
fi
{{ end -}}

echo ""
echo "✨ Installation complete!"
echo ""
echo "📝 Next steps:"
echo "   1. Run 'mise install' to install version-managed tools (node, python, java, etc.)"
echo "   2. Restart your terminal or run 'exec fish' to load the new shell"
echo "   3. Fish plugins will be installed automatically via fisher on first launch"
{{ if eq .chezmoi.os "darwin" -}}
echo "   4. For yabai and skhd, you may need to disable SIP partially. See:"
echo "      https://github.com/koekeishiya/yabai/wiki/Disabling-System-Integrity-Protection"
{{ end -}}
echo ""

# Hash for detecting changes in package list
# If you add/remove packages above, update this timestamp to trigger reinstall
# Last updated: {{ now | date "2006-01-02 15:04:05" }}
