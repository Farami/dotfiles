layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "#[bg=#1e1e2e] {mode} {tabs}"
                format_center ""
                format_right  "#[bg=#1e1e2e]{datetime} #[bg=#1e1e2e]#[fg=#cba6f7,bg=#1e1e2e]#[fg=#11111b,bg=#cba6f7,bold]  {session} #[fg=#cba6f7,bg=#1e1e2e] "
                format_space  "#[bg=#1e1e2e]"
                format_hide_on_overlength "true"
                format_precedence "lrc"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#6C7086]{char}"
                border_position "top"

                // ── Mode badge (color-coded rounded pill) ──────────────────
                mode_normal        "#[fg=#a6e3a1,bg=#1e1e2e]#[fg=#11111b,bg=#a6e3a1,bold] NORMAL #[fg=#a6e3a1,bg=#1e1e2e]"
                mode_locked        "#[fg=#585b70,bg=#1e1e2e]#[fg=#cdd6f4,bg=#585b70,bold] LOCKED #[fg=#585b70,bg=#1e1e2e]"
                mode_resize        "#[fg=#f38ba8,bg=#1e1e2e]#[fg=#11111b,bg=#f38ba8,bold] RESIZE #[fg=#f38ba8,bg=#1e1e2e]"
                mode_pane          "#[fg=#89b4fa,bg=#1e1e2e]#[fg=#11111b,bg=#89b4fa,bold] PANE #[fg=#89b4fa,bg=#1e1e2e]"
                mode_tab           "#[fg=#b4befe,bg=#1e1e2e]#[fg=#11111b,bg=#b4befe,bold] TAB #[fg=#b4befe,bg=#1e1e2e]"
                mode_scroll        "#[fg=#f9e2af,bg=#1e1e2e]#[fg=#11111b,bg=#f9e2af,bold] SCROLL #[fg=#f9e2af,bg=#1e1e2e]"
                mode_enter_search  "#[fg=#89dceb,bg=#1e1e2e]#[fg=#11111b,bg=#89dceb,bold] SEARCH: #[fg=#89dceb,bg=#1e1e2e]"
                mode_search        "#[fg=#89dceb,bg=#1e1e2e]#[fg=#11111b,bg=#89dceb,bold] SEARCH #[fg=#89dceb,bg=#1e1e2e]"
                mode_rename_tab    "#[fg=#b4befe,bg=#1e1e2e]#[fg=#11111b,bg=#b4befe,bold] RENAME TAB #[fg=#b4befe,bg=#1e1e2e]"
                mode_rename_pane   "#[fg=#89b4fa,bg=#1e1e2e]#[fg=#11111b,bg=#89b4fa,bold] RENAME PANE #[fg=#89b4fa,bg=#1e1e2e]"
                mode_session       "#[fg=#cba6f7,bg=#1e1e2e]#[fg=#11111b,bg=#cba6f7,bold] SESSION #[fg=#cba6f7,bg=#1e1e2e]"
                mode_move          "#[fg=#fab387,bg=#1e1e2e]#[fg=#11111b,bg=#fab387,bold] MOVE #[fg=#fab387,bg=#1e1e2e]"
                mode_prompt        "#[fg=#94e2d5,bg=#1e1e2e]#[fg=#11111b,bg=#94e2d5,bold] PROMPT #[fg=#94e2d5,bg=#1e1e2e]"
                mode_tmux          "#[fg=#fab387,bg=#1e1e2e]#[fg=#11111b,bg=#fab387,bold] TMUX #[fg=#fab387,bg=#1e1e2e]"

                // ── Tabs (rounded pills; mauve accent when active) ─────────
                tab_normal              "#[fg=#313244,bg=#1e1e2e]#[fg=#89b4fa,bg=#313244,bold] {index} #[fg=#cdd6f4,bg=#313244]{name}{floating_indicator} #[fg=#313244,bg=#1e1e2e]"
                tab_normal_fullscreen   "#[fg=#313244,bg=#1e1e2e]#[fg=#89b4fa,bg=#313244,bold] {index} #[fg=#cdd6f4,bg=#313244]{name}{fullscreen_indicator} #[fg=#313244,bg=#1e1e2e]"
                tab_normal_sync         "#[fg=#313244,bg=#1e1e2e]#[fg=#89b4fa,bg=#313244,bold] {index} #[fg=#cdd6f4,bg=#313244]{name}{sync_indicator} #[fg=#313244,bg=#1e1e2e]"

                tab_active              "#[fg=#cba6f7,bg=#1e1e2e]#[fg=#11111b,bg=#cba6f7,bold] {index} #[fg=#11111b,bg=#cba6f7,bold]{name}{floating_indicator} #[fg=#cba6f7,bg=#1e1e2e]"
                tab_active_fullscreen   "#[fg=#cba6f7,bg=#1e1e2e]#[fg=#11111b,bg=#cba6f7,bold] {index} #[fg=#11111b,bg=#cba6f7,bold]{name}{fullscreen_indicator} #[fg=#cba6f7,bg=#1e1e2e]"
                tab_active_sync         "#[fg=#cba6f7,bg=#1e1e2e]#[fg=#11111b,bg=#cba6f7,bold] {index} #[fg=#11111b,bg=#cba6f7,bold]{name}{sync_indicator} #[fg=#cba6f7,bg=#1e1e2e]"

                tab_separator           "#[bg=#1e1e2e] "

                tab_sync_indicator       " "
                tab_fullscreen_indicator " "
                tab_floating_indicator   " "

                // ── Clock pill (blue chip + date/time) ─────────────────────
                datetime          "#[fg=#89b4fa,bg=#1e1e2e]#[fg=#11111b,bg=#89b4fa,bold]  #[fg=#cdd6f4,bg=#313244] {format} #[fg=#313244,bg=#1e1e2e]"
                datetime_format   "%a %d %b  %H:%M"
                datetime_timezone "Europe/Berlin"
            }
        }
        pane {
            children
        }
    }
}
